
# -----------------------------------------------------------------
# 🛠️ SECCIÓN DE FUNCIONES 
# -----------------------------------------------------------------
def calcular_costo_atencion(tipo_servicio, urgencia):
    costo_base = 0
    if tipo_servicio == "1":    # Consulta Médica
        costo_base = 5000
    elif tipo_servicio == "2":  # Baño y Corte de Uñas (Estética)
        costo_base = 7000
        
    if urgencia == "Alta":
        recargo = costo_base * 0.20
    else:
        recargo = 0
        
    return costo_base + recargo


# -----------------------------------------------------------------
# 🚀 PROCESO PRINCIPAL
# -----------------------------------------------------------------

total_recaudado = 0
total_atenciones = 0

cant_caninos = 0
cant_felinos = 0
cant_aves = 0
cant_reptiles = 0

max_gasto = 0
max_nombre_mascota = ""
max_familia_mascota = ""

LIMITE_TURNOS = 5
turnos_dados_medicos = 0
turnos_dados_estetica = 0

print("========================================")
print("   SISTEMA DE GESTIÓN VETERINARIA V5.0  ")
print("========================================")

opcion = ""

while opcion != "3":
    print("\n--- MENÚ PRINCIPAL ---")
    print("1. Registrar/Asignar Turno y Atención")
    print("2. Mostrar Reporte Estadístico del Día")
    print("3. Cerrar Sistema y Salir")
    opcion = input("Seleccione una opción (1-3): ")
    
    if opcion == "1":
        print("\n--- GESTIÓN DE TURNOS DISPONIBLES ---")
        print(f"1. Consulta Médica     (Turnos dados: {turnos_dados_medicos}/{LIMITE_TURNOS})")
        print(f"2. Baño y Corte (Estética) (Turnos dados: {turnos_dados_estetica}/{LIMITE_TURNOS})")
        servicio = input("Seleccione el servicio que solicita el cliente (1-2): ")
        
        if servicio == "1" and turnos_dados_medicos >= LIMITE_TURNOS:
            print("\n LO SIENTO: No quedan turnos disponibles para Consulta Médica.")
            continue
        elif servicio == "2" and turnos_dados_estetica >= LIMITE_TURNOS:
            print("\n LO SIENTO: No quedan turnos disponibles para Estética.")
            continue
        elif servicio not in ["1", "2"]:
            print("\n Opción de servicio no válida.")
            continue

        print("\n--- DATOS DE LA MASCOTA ---")
        nombre_mascota = input("Nombre de la mascota: ")
        
        print("\nCategorías de familia: 1. Canino | 2. Felino | 3. Ave | 4. Reptil")
        categoria = input("Seleccione la categoría (1-4): ")
        
        if categoria == "1": nombre_familia = "Canino"
        elif categoria == "2": nombre_familia = "Felino"
        elif categoria == "3": nombre_familia = "Ave"
        elif categoria == "4": nombre_familia = "Reptil"
        else: nombre_familia = "Desconocida"
            
        if servicio == "2" and categoria not in ["1", "2"]:
            print(f"\n CONTROL DE SEGURIDAD: Estética NO disponible para {nombre_familia}.")
            print("El sistema reajustó el turno automáticamente a '1' (Consulta Médica).")
            servicio = "1"
            if turnos_dados_medicos >= LIMITE_TURNOS:
                print(" Tampoco hay turnos médicos disponibles. Operación cancelada.")
                continue
            
        especie_raza = input("Especie o Raza específica: ")
        print("\nNivel de Urgencia (Alta / Media / Baja): ")
        nivel_urgencia = input("Ingrese la urgencia: ").capitalize()
        
        monto_actual = calcular_costo_atencion(servicio, nivel_urgencia)
        
        if servicio == "1":
            numero_turno_asignado = turnos_dados_medicos + 1
        else:
            numero_turno_asignado = turnos_dados_estetica + 1

        # 🔍 SUBMENÚ DE REVISIÓN Y CORRECCIÓN QUIRÚRGICA
        datos_correctos = False
        while datos_correctos == False:
            print("\n----------------------------------------")
            print(f"   🔍 REVISE EL TURNO #{numero_turno_asignado} ANTES DE CONFIRMAR")
            print("----------------------------------------")
            print(f"1. Nombre:    {nombre_mascota}")
            print(f"2. Familia:   {nombre_familia} ({especie_raza})")
            print(f"3. Servicio:  {'Consulta Médica' if servicio == '1' else 'Baño y Uñas'}")
            print(f"4. Urgencia:  {nivel_urgencia}")
            print(f"   Precio:    ${monto_actual}")
            print("----------------------------------------")
            print("5. [ CONFIRMAR TURNO Y GUARDAR ]")
            print("6. [ CANCELAR TODO Y VOLVER AL MENÚ ]")
            
            opcion_editar = input("Seleccione el número a corregir o confirme (1-6): ")
            
            if opcion_editar == "1":
                nombre_mascota = input("Ingrese el nombre CORRECTO: ")
            elif opcion_editar == "2":
                print("\nNuevas Categorías: 1. Canino | 2. Felino | 3. Ave | 4. Reptil")
                categoria = input("Seleccione la nueva categoría (1-4): ")
                if categoria == "1": nombre_familia = "Canino"
                elif categoria == "2": nombre_familia = "Felino"
                elif categoria == "3": nombre_familia = "Ave"
                elif categoria == "4": nombre_familia = "Reptil"
                especie_raza = input("Ingrese la nueva Especie/Raza: ")
                if servicio == "2" and categoria not in ["1", "2"]:
                    print(f"\n CONTROL: Estética NO disponible para {nombre_familia}. Reajustado a Consulta.")
                    servicio = "1"
                monto_actual = calcular_costo_atencion(servicio, nivel_urgencia)
            elif opcion_editar == "3":
                print("\nNuevos Servicios: 1. Consulta Médica | 2. Baño y Corte de Uñas")
                nuevo_servicio = input("Seleccione el nuevo servicio (1-2): ")
                if nuevo_servicio == "2" and categoria not in ["1", "2"]:
                    print(f"\n ERROR: Estética NO disponible para {nombre_familia}.")
                else:
                    servicio = nuevo_servicio
                monto_actual = calcular_costo_atencion(servicio, nivel_urgencia)
            elif opcion_editar == "4":
                nivel_urgencia = input("Ingrese la nueva urgencia (Alta/Media/Baja): ").capitalize()
                monto_actual = calcular_costo_atencion(servicio, nivel_urgencia)
            elif opcion_editar == "5":
                if servicio == "1" and turnos_dados_medicos >= LIMITE_TURNOS:
                    print("\n Error: Se agotaron los turnos médicos mientras editaba.")
                    opcion_editar = "6"
                    break
                elif servicio == "2" and turnos_dados_estetica >= LIMITE_TURNOS:
                    print("\n Error: Se agotaron los turnos de estética mientras editaba.")
                    opcion_editar = "6"
                    break
                print("\n💾 Confirmando turno...")
                datos_correctos = True 
            elif opcion_editar == "6":
                print("\n Registro de turno cancelado.")
                break 
                
        if opcion_editar == "6":
            continue 
            
        # =============================================================
        # 💾 REGISTRO DEFINITIVO (Impacto en memoria y disco)
        # =============================================================
        
        # 1. Escritura en el Archivo de Texto (El Historial Físico)
        nombre_servicio_texto = "Consulta Médica" if servicio == "1" else "Estética"
        
        # Abrimos el archivo en modo 'a' (Append)
        archivo_historial = open("historial_veterinaria.txt", "a")
        
        # Creamos una línea de texto ordenada. El '\n' al final sirve para hacer un Enter en el archivo.
        linea_ticket = f"Turno: {numero_turno_asignado} | Mascota: {nombre_mascota} ({nombre_familia}-{especie_raza}) | Servicio: {nombre_servicio_texto} | Total: ${monto_actual}\n"
        
        # Escribimos y cerramos de inmediato
        archivo_historial.write(linea_ticket)
        archivo_historial.close()
        
        print("📝 Ticket guardado exitosamente en 'historial_veterinaria.txt'")
        
        # 2. Impacto en los contadores de memoria (Igual que antes)
        if servicio == "1":
            turnos_dados_medicos += 1
        else:
            turnos_dados_estetica += 1
            
        if categoria == "1": cant_caninos += 1
        elif categoria == "2": cant_felinos += 1
        elif categoria == "3": cant_aves += 1
        elif categoria == "4": cant_reptiles += 1
            
        total_recaudado += monto_actual
        total_atenciones += 1
        
        if monto_actual > max_gasto:
            max_gasto = monto_actual
            max_nombre_mascota = nombre_mascota
            max_familia_mascota = nombre_familia
            
        print(f"¡Éxito! Se reservó el Turno #{numero_turno_asignado} para {nombre_mascota}.\n")
        
    elif opcion == "2":
        # --- REPORTE FINAL / ESTADÍSTICAS ---
        print("\n========================================")
        print("   REPORTE ESTADÍSTICO DE LA JORNADA   ")
        print("========================================")
        print(f"Monto total recaudado en caja: ${total_recaudado}")
        print(f"Cantidad total de atenciones/turnos confirmados: {total_atenciones}")
        print(f"Turnos Médicos ocupados: {turnos_dados_medicos}/{LIMITE_TURNOS}")
        print(f"Turnos de Estética ocupados: {turnos_dados_estetica}/{LIMITE_TURNOS}")
        print("----------------------------------------")
        
        if total_atenciones > 0:
            porc_caninos = (cant_caninos / total_atenciones) * 100
            porc_felinos = (cant_felinos / total_atenciones) * 100
            porc_aves = (cant_aves / total_atenciones) * 100
            porc_reptiles = (cant_reptiles / total_atenciones) * 100
            promedio_ticket = total_recaudado / total_atenciones
            
            print("Frecuencia por Familias Atendidas:")
            print(f"- Caninos:  {cant_caninos} ({porc_caninos:.2f}%)")
            print(f"- Felinos:  {cant_felinos} ({porc_felinos:.2f}%)")
            print(f"- Aves:     {cant_aves} ({porc_aves:.2f}%)")
            print(f"- Reptiles: {cant_reptiles} ({porc_reptiles:.2f}%)")
            print("----------------------------------------")
            print(f"Gasto promedio por consulta: ${promedio_ticket:.2f}")
            print(f"Récord de mayor facturación: {max_nombre_mascota} ({max_familia_mascota}) con un total de ${max_gasto}")
        else:
            print("Aún no se registraron atenciones en el sistema.")
        print("========================================")
        
    elif opcion == "3":
        print("\nCerrando el sistema de la veterinaria. ¡Hasta mañana!")
    else:
        print("\n Opción no válida. Por favor, seleccione 1, 2 o 3.")
      
        
